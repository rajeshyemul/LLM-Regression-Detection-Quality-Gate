# LLM Provider Configuration
LLM_PROVIDER=mock
OLLAMA_HOST=http://localhost:11434

# Model Selection
LLM_MODEL=qwen2.5:3b
JUDGE_MODEL=qwen2.5:7b
TEMPERATURE=0.0

# Execution Mode: real | mock | replay
EXECUTION_MODE=mock

# Regression & Quality Gate Thresholds
WARNING_ACCURACY_DELTA=0.03
CRITICAL_ACCURACY_DELTA=0.08
MIN_SUMMARY_SCORE_THRESHOLD=4.0

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=
